# ── Copy to .env and adjust ──────────────────────────────
# Capture: simulate | live
NAD_CAPTURE_MODE=simulate
NAD_INTERFACE=lo
NAD_FLOW_TIMEOUT=60

# Storage & models
NAD_DB_PATH=data/alerts.db
NAD_MODEL_DIR=models
NAD_MODEL_TYPE=hybrid
NAD_ANOMALY_THRESHOLD=0.7
NAD_WS_BROADCAST_INTERVAL=1.0

# Signature thresholds (see docs/DETECTION_CATALOG.md)
NAD_PORT_SCAN_PORTS=15
NAD_PORT_SCAN_WINDOW=60
NAD_SYN_FLOOD_COUNT=50
NAD_SYN_FLOOD_WINDOW=10
NAD_UDP_FLOOD_COUNT=200
NAD_UDP_FLOOD_WINDOW=10
NAD_ICMP_FLOOD_COUNT=100
NAD_ICMP_FLOOD_WINDOW=10
NAD_DDOS_PPS=1000
NAD_BRUTE_FORCE_FAILS=10
NAD_BRUTE_FORCE_WINDOW=300
NAD_DNS_TUNNEL_LEN=53
NAD_EXFIL_BYTES=10000000
NAD_SWEEP_DSTS=10
NAD_SWEEP_WINDOW=60
NAD_HORIZ_DSTS=10
NAD_HORIZ_WINDOW=60
NAD_SPRAY_DSTS=5
NAD_SMB_COUNT=20
NAD_SMB_WINDOW=60
NAD_SLOWLORIS_COUNT=50
NAD_SLOWLORIS_WINDOW=60
NAD_AMP_COUNT=50
NAD_AMP_WINDOW=10

# Site monitor (Websites tab)
NAD_SITE_CHECK_DEFAULT_INTERVAL=60
NAD_SITE_CHECK_TIMEOUT=10.0
NAD_ALLOW_PRIVATE_TARGETS=false
# Optional: auto-register a site on first boot
# NAD_SEED_SITE_URL=https://your-site.com
